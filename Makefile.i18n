#
# i18n management for Python projects
#
# This file contains targets for managing translations and message catalogs.
#
# Recommended Workflow for updating translations:
# 1. make i18n-extract   - Extract source strings into messages.pot
# 2. make i18n-update    - Update existing PO files with new strings from POT; a changed
#                          string becomes a new, empty entry (no fuzzy matching)
# 3. make i18n-autotranslate - Use LLM to translate missing strings
# 4. make i18n-compile   - Compile PO files into MO binary files for runtime
#
# Shortcut: 'make translations' runs i18n-update followed by i18n-compile.
#
# Other targets:
# - make i18n-check      - Verify translation health (missing strings, variable mismatches)
# - make i18n-clear-fuzzy - Blank any entries already marked fuzzy, so autotranslate redoes them
# - make i18n-init LOCALE=xx - Initialize a new translation catalog for a new language
#

#############################################################################
## i18n

.PHONY: venv-i18n
venv-i18n: $(VENV)/$(MARKER)-i18n
$(VENV)/$(MARKER)-i18n: $(VENV)/$(MARKER)
	$(VENV)/pip install -e .[i18n]
	touch $@

# --ignore-dirs replaces Babel's default (dot and underscore directories), so
# repeat those, or .claude/worktrees and other tool directories get scanned.
.PHONY: i18n-extract
i18n-extract: venv-i18n
	PYTHONPATH=. $(VENV)/pybabel extract --omit-header --ignore-dirs=".* _* build dist" -F tools/i18n/babel.cfg -o $(PROJECT)/translations/messages.pot .

.PHONY: i18n-update
i18n-update: i18n-extract venv-i18n
	$(VENV)/pybabel update --no-fuzzy-matching -i $(PROJECT)/translations/messages.pot -d $(PROJECT)/translations

.PHONY: i18n-clear-fuzzy
i18n-clear-fuzzy: venv-i18n
	PYTHONPATH=. $(VENV)/python -m tools.i18n.clear_fuzzy --locale_dir $(PROJECT)/translations

.PHONY: i18n-autotranslate
i18n-autotranslate: venv-i18n
	$(VENV)/python -m tools.i18n.autotranslate --locale_dir $(PROJECT)/translations --model $(or $(MODEL), 'mlx-community/aya-23-8B-4bit') #--rpm $(or $(RPM),10)

.PHONY: i18n-compile
i18n-compile: venv-i18n
	$(VENV)/pybabel compile -d $(PROJECT)/translations

.PHONY: translations
translations: i18n-update i18n-compile

.PHONY: i18n-check
i18n-check: venv-i18n
	PYTHONPATH=. $(VENV)/python -m tools.i18n.check

.PHONY: i18n-init
i18n-init: venv-i18n
	@if [ -z "$(LOCALE)" ]; then echo "Usage: make init_locale LOCALE=xx"; exit 1; fi
	$(VENV)/pybabel init -i $(PROJECT)/translations/messages.pot -d $(PROJECT)/translations -l $(LOCALE)
